<Window x:Class="TableAssigner.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TableAssigner.UI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="700" Width="800">
    <Window.DataContext>
        <local:VenueModel/>
    </Window.DataContext>
    <Grid Background="Green">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="{Binding Name}"/>
        <!--<ScrollViewer Grid.Row="1">-->
        <TabControl Grid.Row="1" ItemsSource="{Binding Locations}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding Name}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid MinHeight="200">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.RowSpan="2" Content="{Binding Canvas}"/>
                        <StackPanel Orientation="Vertical" Grid.Column="1">
                            <Button Command="{Binding AddTableCommand}"
                                    Content="Add table"/>
                            <Label>Location Name</Label>
                            <TextBox Text="{Binding Name}"/>
                            <ListView ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" MinHeight="150">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding TableName}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TableName}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Width" DisplayMemberBinding="{Binding Width}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Width}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Length" DisplayMemberBinding="{Binding Length}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Length}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="X" DisplayMemberBinding="{Binding X}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding X}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Y" DisplayMemberBinding="{Binding Y}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Y}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel>
                                <Button Command="{Binding DeleteTableCommand}" 
                                        CommandParameter="{Binding SelectedTable}"
                                        Content="Delete Table"/>
                                <Button Command="{Binding CopyTableCommand}"
                                        CommandParameter="{Binding SelectedTable}"
                                        Content="Copy"/>
                                <Grid DataContext="{Binding SelectedTable}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <Label>Table name</Label>
                                    <TextBox Grid.Row="1" Text="{Binding TableName}" Grid.ColumnSpan="4"/>
                                    <!--<Button Grid.Row="2" Grid.ColumnSpan="2" Content="Vertical" Command="{Binding SetVerticalCommand}"/>
                                    <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="Horizontal" Command="{Binding SetHorizontalCommand}"/>-->
                                    <Button Grid.ColumnSpan="4" Content="Switch height/width" Command="{Binding SwitchDimensionsCommand}"/>
                                    <Label Grid.Row="12" Grid.ColumnSpan="2">Width</Label>
                                    <Label Grid.Row="12" Grid.Column="2" Grid.ColumnSpan="2">Length</Label>
                                    <TextBox Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Width}"/>
                                    <TextBox Grid.Row="13" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Length}"/>
                                    <Button Grid.Row="15" Grid.Column="0" Command="{Binding ModifyWidthCommand}" Content="-">
                                        <Button.CommandParameter>
                                            <sys:Int32>-1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="15" Grid.Column="1" Command="{Binding ModifyWidthCommand}" Content="+">
                                        <Button.CommandParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="15" Grid.Column="2" Command="{Binding ModifyLengthCommand}" Content="-">
                                        <Button.CommandParameter>
                                            <sys:Int32>-1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="15" Grid.Column="03" Command="{Binding ModifyLengthCommand}" Content="+">
                                        <Button.CommandParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Label Grid.Row="17" Grid.ColumnSpan="2">X</Label>
                                    <Label Grid.Row="17" Grid.Column="2" Grid.ColumnSpan="2">Y</Label>
                                    <TextBox Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding X}"/>
                                    <TextBox Grid.Row="18" Grid.Column="2" Grid.ColumnSpan="2" Text="{Binding Y}"/>
                                    <Button Grid.Row="19" Grid.Column="2" Command="{Binding ModifyYCommand}" Content="-">
                                        <Button.CommandParameter>
                                            <sys:Int32>-1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="19" Grid.Column="3" Command="{Binding ModifyYCommand}" Content="+">
                                        <Button.CommandParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="19" Grid.Column="0" Command="{Binding ModifyXCommand}"  Content="-">
                                        <Button.CommandParameter>
                                            <sys:Int32>-1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Grid.Row="19" Grid.Column="1" Command="{Binding ModifyXCommand}" Content="+">
                                        <Button.CommandParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Button.CommandParameter>
                                    </Button>

                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
        <!--<ItemsControl Background="Red" ItemsSource="{Binding Locations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="200">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Content="{Binding Name}"/>
                            <ContentPresenter Grid.Row="1" Content="{Binding Canvas}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>-->
        <!--</ScrollViewer>-->
    </Grid>
    
</Window>
